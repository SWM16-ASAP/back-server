# Copy this file to terraform.tfvars. terraform.tfvars is ignored by Git.
aws_region  = "ap-northeast-2"
test_run_id = "phase-two"
availability_zones = [
  "ap-northeast-2a",
  "ap-northeast-2b",
]

# Use a unique immutable tag for the commit under test.
app_image_tag                    = "replace-with-git-sha"
container_port                   = 8080
health_check_path                = "/actuator/health"
health_check_grace_period_seconds = 180
app_desired_count                = 2
mock_scenario                     = "success"
grafana_allowed_cidr              = "127.0.0.1/32" # Replace with the viewer's public IP, for example 203.0.113.10/32.
