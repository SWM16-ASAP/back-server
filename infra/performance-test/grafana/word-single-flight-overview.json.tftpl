{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Word API",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 7, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/words/{word}\"}[$__rate_interval]))", "legendFormat": "requests/s", "refId": "A" }],
      "title": "Word API RPS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 10, "x": 7, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v1/words/{word}\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v1/words/{word}\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v1/words/{word}\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C" }
      ],
      "title": "Word API Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 7, "x": 17, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/words/{word}\",status=~\"2..\"}[$__rate_interval]))", "legendFormat": "2xx", "refId": "A" },
        { "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/words/{word}\",status=~\"4..\"}[$__rate_interval]))", "legendFormat": "4xx", "refId": "B" },
        { "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/words/{word}\",status=~\"5..\"}[$__rate_interval]))", "legendFormat": "5xx", "refId": "C" }
      ],
      "title": "Word HTTP Outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "id": 11,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "expr": "sum(increase(word_lookup_results_total{outcome=\"hit\"}[$__range]))", "legendFormat": "stored result hit", "refId": "A" },
        { "expr": "sum(increase(word_lookup_results_total{outcome=\"miss\"}[$__range]))", "legendFormat": "new word miss", "refId": "B" }
      ],
      "title": "Word Stored Result Lookup",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 101,
      "panels": [],
      "title": "Single-flight",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "expr": "sum(increase(word_single_flight_requests_total{role=\"leader\"}[$__range]))", "legendFormat": "leader", "refId": "A" },
        { "expr": "sum(increase(word_single_flight_requests_total{role=\"follower\"}[$__range]))", "legendFormat": "follower", "refId": "B" },
        { "expr": "sum(increase(word_single_flight_requests_total{role=\"bypass\"}[$__range]))", "legendFormat": "bypass", "refId": "C" }
      ],
      "title": "Single-flight Roles",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "expr": "sum(increase(word_single_flight_requests_total{role=\"follower\",outcome=\"success\"}[$__range]))", "legendFormat": "success", "refId": "A" },
        { "expr": "sum(increase(word_single_flight_requests_total{role=\"follower\",outcome=\"timeout\"}[$__range]))", "legendFormat": "timeout", "refId": "B" },
        { "expr": "sum(increase(word_single_flight_requests_total{role=\"follower\",outcome=\"error\"}[$__range]))", "legendFormat": "error", "refId": "C" }
      ],
      "title": "Follower Outcomes",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(word_single_flight_follower_wait_seconds_bucket{outcome=\"signaled\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(word_single_flight_follower_wait_seconds_bucket{outcome=\"signaled\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B" }
      ],
      "title": "Follower Wait",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "sum by (operation) (increase(word_single_flight_lock_failures_total[$__range]))", "legendFormat": "{{operation}}", "refId": "A" }],
      "title": "Lock Failures",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 102,
      "panels": [],
      "title": "Bedrock Client",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 35 },
      "id": 8,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "sum by (outcome) (increase(word_bedrock_calls_total[$__range]))", "legendFormat": "{{outcome}}", "refId": "A" }],
      "title": "Bedrock Calls",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 35 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(word_bedrock_duration_seconds_bucket{outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(word_bedrock_duration_seconds_bucket{outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B" }
      ],
      "title": "Bedrock Call Duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 35 },
      "id": 10,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "expr": "sum(increase(word_bedrock_sdk_attempts_total[$__range]))", "legendFormat": "attempts", "refId": "A" },
        { "expr": "sum(increase(word_bedrock_sdk_retries_total[$__range]))", "legendFormat": "retries", "refId": "B" }
      ],
      "title": "SDK Attempts and Retries",
      "type": "stat"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["performance-test", "word", "${test_run_id}"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LLV Word Single-flight - ${test_run_id}",
  "uid": "llv-word-single-flight",
  "version": 1
}
